# Optional server settings. Defaults work without this file.
# Set these in your hosting environment; never commit real credentials.
# APP_DATA_DIR=/persistent-volume/inkforma
# PUBLIC_ORIGIN=https://tu-estudio.example
# PORT=5173
# Optional AI credential, injected privately on the server (never use VITE_):
# INKFORMA_GEMINI_KEY=<provide securely; do not commit a real value>

# Optional supported Gemini model ID (defaults to gemini-2.5-flash-lite):
# INKFORMA_GEMINI_MODEL=gemini-2.5-flash-lite
